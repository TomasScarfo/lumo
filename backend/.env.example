# Para probar en tu computadora, copiá este archivo como .env. NUNCA lo subas a GitHub.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Tiene que ser idéntica a la que cargaste en la app de Mercado Libre.
REDIRECT_URI=https://TU-APP.onrender.com/callback
# Cualquier texto largo y aleatorio (en Render se genera solo).
ENCRYPTION_KEY=
SECRET_KEY=
# En Render: la cadena "Session pooler" de Supabase. En local se puede dejar vacía (usa un archivo SQLite).
DATABASE_URL=
# IDs de Mercado Libre de quienes administran Lumo, separados por coma. Entran siempre y crean las invitaciones en /admin.
ADMIN_USER_IDS=
# Contacto de la portada (opcional: ya tienen valores por defecto). Con los dos vacíos, la sección no se muestra.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
# Para que el formulario de contacto llegue por email: clave de API de resend.com (con permiso solo de envío).
RESEND_API_KEY=
