# Para probar en tu computadora, copiá este archivo como .env. NUNCA lo subas a GitHub.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Tiene que ser idéntica a la que cargaste en la app de Mercado Libre.
REDIRECT_URI=https://TU-APP.onrender.com/callback
# Cualquier texto largo y aleatorio (en Render se genera solo).
ENCRYPTION_KEY=
SECRET_KEY=
# En Render: la cadena "Session pooler" de Supabase. En local se puede dejar vacía (usa un archivo SQLite).
DATABASE_URL=
# IDs de Mercado Libre de quienes administran Lumo, separados por coma. Entran siempre y crean las invitaciones en /admin.
ADMIN_USER_IDS=
# Contacto de la portada (opcional: ya tienen valores por defecto). Con los tres vacíos, la sección no se muestra.
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_LINKEDIN=

# Cobro con Mercado Pago. Sin el token o sin precio, la prueba gratis funciona pero no se puede pagar.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks de la aplicación de Mercado Pago (para verificar los avisos).
MP_WEBHOOK_SECRET=
# Precio mensual (solo el número) y moneda.
PLAN_PRICE=
PLAN_CURRENCY=ARS
TRIAL_DAYS=14
